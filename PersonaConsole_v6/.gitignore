build/
*.o
*.so

# per-profile runtime state — regenerated on first run
profiles/*/state.bin
profiles/*/memory.bin
profiles/*/chapters.bin
profiles/*/actor_index.bin
profiles/*/speech_events.bin
# per-actor sidecars under profiles/*/relations/ are runtime state
profiles/*/relations/
profiles/*/aether/

# per-profile build artifacts — regenerated by `make`
profiles/*/.bins.stamp
profiles/*/*.cart
