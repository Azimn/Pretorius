# EditorConfig — keep formatting identical across Linux and Windows editors,
# so neither contributor's editor silently reintroduces CRLF or tab/space drift.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

# Windows shell tooling keeps CRLF (matches .gitattributes).
[*.{cmd,bat,ps1}]
end_of_line = crlf
